# ---------------------------------------------------------------------------
# Local development works WITHOUT any of these — upload, edit and preview all
# run with no config. The variables below only enable the MP4 export (Lambda).
# ---------------------------------------------------------------------------

# Public base URL where /uploads/* is reachable by AWS Lambda.
# In local dev, expose your app with a tunnel (e.g. ngrok) and put its URL here,
# or host source videos on a public bucket/CDN. Leave unset to disable export.
# PUBLIC_BASE_URL=https://your-tunnel-or-cdn.example.com

# AWS credentials used by @remotion/lambda.
# REMOTION_AWS_ACCESS_KEY_ID=...
# REMOTION_AWS_SECRET_ACCESS_KEY=...

# Filled in by `npm run remotion:deploy` (copy its printed output here):
# REMOTION_AWS_REGION=us-east-1
# REMOTION_LAMBDA_FUNCTION=remotion-render-...
# REMOTION_SERVE_URL=https://...s3...amazonaws.com/sites/renderer-video-editor/index.html
